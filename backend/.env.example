# ============================================================
# Aarav Enterprises — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aarav_enterprises
MYSQL_USER=root
MYSQL_PASSWORD=

# JWT Authentication
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES=7d

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# WhatsApp Business Cloud API
# Set WA_MODE=real to use actual WhatsApp API
WA_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=aarav_verify_token_2025

# AI Provider
# Options: mock (default), openai, gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# File Storage (local by default)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Optional: Cloud Storage (future)
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=ap-south-1
